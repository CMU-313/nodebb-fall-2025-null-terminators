{
  "esversion": 2020,
  "node": true,
  "strict": false,
  "globalstrict": false,
  "undef": true,
  "unused": true,
  "latedef": true,
  "nonbsp": true,
  "nonew": true,
  "immed": true,
  "noarg": true,
  "sub": true,
  "boss": true,
  "eqnull": true,
  "validthis": true,
  "browser": false,
  "devel": false,
  "debug": false,
  "evil": false,
  "forin": false,
  "maxlen": 120,
  "indent": 4,
  "predef": [
    "global",
    "process",
    "console",
    "Buffer",
    "exports",
    "module",
    "require",
    "__dirname",
    "__filename",
    "setTimeout",
    "clearTimeout",
    "setInterval",
    "clearInterval"
  ],
  "globals": {
    "describe": false,
    "it": false,
    "before": false,
    "beforeEach": false,
    "after": false,
    "afterEach": false,
    "expect": false,
    "should": false,
    "assert": false
  }
}